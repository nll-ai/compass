# Convex
# Local dev: use local backend (npx convex dev). Example:
#   CONVEX_DEPLOYMENT=local:local-<team>-<project>
#   NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Deployed (Vercel etc.): set in hosting env to your cloud deployment. Example:
#   NEXT_PUBLIC_CONVEX_URL=https://<deployment-name>.convex.cloud
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Scan API (manual trigger and cron use .env.local keys; set this so /api/scan can talk to Convex)
SCAN_SECRET=

# Groq (LLM for scans, digest, agents, schedule parse, target lookup — @ai-sdk/groq)
GROQ_API_KEY=
# Default model: GPT-OSS 120B (Groq id: openai/gpt-oss-120b). Optional overrides:
# GROQ_MODEL_FAST=
# GROQ_MODEL_SMART=

# Decision Digest: when true, digest LLM also emits delta / materiality / actions / strategic read / confidence (POST /api/scan server).
# Prior digests with the same watch-target scope are loaded for diff + strategic read; tune emphasis:
# DECISION_DIGEST_STRATEGIC_FOCUS=balanced   # or: market | science
# DECISION_DIGEST_STRATEGIC_LENS_CUSTOM=     # optional free-text lens appended to the prompt (overrides FOCUS when non-empty)
# DECISION_DIGEST_ENABLED=false
# Backfill decision briefs on existing runs: `npm run backfill-decision-digest` or POST /api/digest/backfill-decision (SCAN_SECRET + GROQ_API_KEY).
# Convex: run `npx convex dev` (or deploy) whenever you change convex/ — `npm run dev` does not upload functions; missing functions cause backfill/scan errors.

# Optional: log digest detail views to console when set to 1 (client).
# NEXT_PUBLIC_DIGEST_TELEMETRY=

# Exa AI
EXA_API_KEY=

# PubMed (optional)
PUBMED_API_KEY=

# Patents (optional; PatentsView API for US patent search)
PATENTSVIEW_API_KEY=

# SEC EDGAR (optional; if SEC returns 403, set this to a declared User-Agent they accept, e.g. "YourCompany AdminContact@yourcompany.com")
# See https://www.sec.gov/developer
# SEC_EDGAR_USER_AGENT=

# openFDA (optional)
OPENFDA_API_KEY=

# App (must match the URL users visit; Convex JWT issuer uses this)
NEXT_PUBLIC_APP_URL=

# WorkOS AuthKit (sign-in, sessions)
# For each deployment URL (e.g. preview https://compass-five-silk.vercel.app), add that origin's
# callback in WorkOS dashboard (Redirects) and set NEXT_PUBLIC_WORKOS_REDIRECT_URI in that env.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Email allowlist: only these domains and emails can sign in (comma-separated)
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# Convex JWT (app-issued token for Convex auth). Do not commit. Generate with: node scripts/generate-jwt-keys.mjs
CONVEX_JWT_PRIVATE_KEY=

# Digest email (Convex server-side only: set via `npx convex env set KEY value`, not .env.local)
# If RESEND_API_KEY is unset, digest creation still runs but no email is sent.
# RESEND_FROM_EMAIL must be a verified sender in Resend (e.g. "Compass <notifications@yourdomain.com>").
# APP_URL is the base URL for digest links and team invite "Accept" links (/settings?teamInvite=…) in email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# APP_URL=

# One-time team migration (Convex only: npx convex env set MIGRATION_SECRET <value>)
# Then: npx convex run teams:runTeamBootstrap '{"secret":"<same value>"}'  (rotate/remove after use)
# MIGRATION_SECRET=

exports[`buildDigestEmailHtml > renders app-like digest sections with decision brief and signal cards 1`] = `"<div style="margin:0;padding:16px;background:#f9fafb;color:#111827;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.5;"><div style="max-width:760px;margin:0 auto;"><h1 style="font-size:22px;line-height:1.3;margin:0 0 16px;font-weight:700;">Compass daily digest — Apr 20, 2026</h1><section style="margin:0 0 16px;padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:#ffffff;"><p style="margin:0;font-size:14px;line-height:1.6;color:#374151;">Team-wide delta summary.</p></section><section style="margin:0 0 16px;padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:#ffffff;"><h2 style="margin:0 0 10px;font-weight:600;font-size:16px;line-height:1.4;">Decision brief</h2><p style="margin:0 0 10px;"><span style="display:inline-block;padding:4px 8px;border-radius:6px;background:#f3f4f6;color:#374151;font-size:12px;font-weight:600;">Medium confidence</span></p><h3 style="margin:0 0 4px;font-size:14px;line-height:1.4;">What changed</h3><p style="margin:0 0 10px;font-size:14px;line-height:1.6;color:#374151;">Enrollment accelerated.</p><h3 style="margin:0 0 4px;font-size:14px;line-height:1.4;">Why it matters</h3><p style="margin:0 0 10px;font-size:14px;line-height:1.6;color:#374151;">Could move timeline by one quarter.</p><h3 style="margin:0 0 4px;font-size:14px;line-height:1.4;">Strategic read</h3><p style="margin:0 0 10px;font-size:14px;line-height:1.6;color:#374151;white-space:pre-wrap;">[Hypothesis] Competitor posture changed.</p><h3 style="margin:0 0 4px;font-size:14px;line-height:1.4;">Suggested next steps</h3><p style="margin:0;font-size:14px;line-height:1.6;color:#374151;white-space:pre-wrap;">Validate assumptions with KOLs.</p></section><section style="margin:0 0 16px;"><h2 style="margin:0;font-size:18px;line-height:1.4;">Signals (1)</h2></section><section style="margin:0 0 16px;padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:#ffffff;"><h2 style="font-size:18px;line-height:1.4;margin:0 0 8px;">Atrial Natriuretic Peptide (ANP)</h2><p style="margin:0 0 12px;font-size:14px;"><a href="https://compass.example.com/targets/t-alpha/digests" style="color:#2563eb;text-decoration:none;">View full digest for Atrial Natriuretic Peptide (ANP)</a></p><ul style="margin:0;list-style:none;padding:0;"><li style="margin:0 0 10px;padding:12px;border:1px solid #e5e7eb;border-radius:8px;background:#ffffff;"><div style="margin:0 0 8px;"><span style="display:inline-block;margin:0 6px 6px 0;padding:3px 8px;border:1px solid #d1d5db;border-radius:999px;font-size:12px;font-weight:600;color:#374151;">MEDIUM</span><span style="display:inline-block;margin:0 6px 6px 0;padding:3px 8px;border:1px solid #d1d5db;border-radius:999px;font-size:12px;color:#374151;">Trial Update</span></div><h3 style="margin:0 0 8px;font-size:16px;line-height:1.45;font-weight:600;">Phase 2 site expansion</h3><p style="margin:0 0 10px;font-size:14px;line-height:1.6;color:#4b5563;">No additional summary available.</p><p style="margin:0 0 6px;font-size:13px;font-weight:600;color:#6b7280;">Links to original sources</p><ul style="margin:0;list-style:none;padding:0;"><li style="margin:0 0 4px;font-size:13px;line-height:1.5;"><span style="display:inline-block;margin-right:6px;padding:2px 7px;border:1px solid #d1d5db;border-radius:999px;font-size:11px;color:#374151;">CLINICALTRIALS</span><a href="https://example.com/alpha-trial" style="color:#2563eb;text-decoration:none;">Registry entry ↗</a> <span style="font-size:12px;color:#9ca3af;">2026-04-20</span></li></ul></li></ul></section><p style="margin:20px 0 0;font-size:14px;"><a href="https://compass.example.com/targets" style="color:#2563eb;text-decoration:none;">Open Compass — Watch Targets</a></p></div></div>"`;
